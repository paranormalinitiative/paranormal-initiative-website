{
  "name": "nova-spike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TPI-NOVA-002 isolated technology compatibility spike. Not deployed.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check:firefox": "node scripts/firefox-check.mjs",
    "check:chromium": "node scripts/chromium-check.mjs",
    "check:browsers": "npm run check:firefox && npm run check:chromium"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
