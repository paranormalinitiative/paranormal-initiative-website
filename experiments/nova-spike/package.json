    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-table-cell": "3.32.2",
    "@tiptap/extension-table-header": "3.32.2",
    "@tiptap/extension-table-row": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "konva": "10.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "6.2.1",
